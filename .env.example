# Configurações do Banco de Dados PostgreSQL (Local ou Docker)
DATABASE_URL="postgresql://formulaplus_admin:formulaplus_secret_2026@localhost:5432/formulaplus_conecta?schema=public"

# Use a conexão direta (ou pooler de sessão Supabase) para migrações Prisma.
DIRECT_URL="postgresql://formulaplus_admin:formulaplus_secret_2026@localhost:5432/formulaplus_conecta?schema=public"

# Autenticação e Segurança JWT
JWT_SECRET="formula-plus-conecta-super-secret-jwt-key-change-in-production"

# Servidor Backend Fastify
PORT=3333
NODE_ENV="development"

# URLs do frontend autorizadas para CORS, separadas por vírgula.
# Inclua o domínio publicado na Vercel e mantenha localhost para desenvolvimento.
FRONTEND_URL="http://localhost:5173"

# Supabase Storage bucket para imagens dos produtos (credenciais somente no backend).
# SUPABASE_URL="https://<project-ref>.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"
